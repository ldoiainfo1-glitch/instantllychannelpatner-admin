{
  "name": "channel-partner-admin",
  "version": "1.0.0",
  "description": "InstantllyCards Channel Partner Admin Portal",
  "main": "index.html",
  "scripts": {
    "dev": "npx serve .",
    "build": "node -e \"const fs=require('fs');const path=require('path');const dist='dist';if(!fs.existsSync(dist))fs.mkdirSync(dist);fs.readdirSync('.').forEach(f=>{if(!f.startsWith('.')&&f!=='node_modules'&&f!=='dist'&&f!=='package.json'&&f!=='package-lock.json'){const stat=fs.statSync(f);if(stat.isFile())fs.copyFileSync(f,path.join(dist,f))}})\"",
    "start": "npx serve ."
  },
  "keywords": ["admin", "channel-partner", "instantlly"],
  "author": "InstantllyCards",
  "license": "MIT"
}
